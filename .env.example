# Gere as senhas automaticamente com: bash scripts/bootstrap.sh
# Para configurar manualmente, use SOMENTE letras/números nestas três senhas
# (elas também compõem URLs PostgreSQL).
POSTGRES_PASSWORD=CHANGE_ME_ADMIN
APP_DB_PASSWORD=CHANGE_ME_APP
MIGRATOR_DB_PASSWORD=CHANGE_ME_MIGRATOR

APP_PORT=8080
MCP_PORT=8001
# Inclui a espera pela CPU compartilhada com ingestão e chat.
MCP_REQUEST_TIMEOUT_SECONDS=180
# Valores iniciais. Após salvar pela interface, as configurações do PostgreSQL
# prevalecem sobre estes valores em reinícios. Ajuste em Configurações no frontend.
OLLAMA_MODEL=qwen3:1.7b-q4_K_M
# Alternativa com menor consumo, com perda de qualidade: qwen3:0.6b-q4_K_M
CPU_THREADS=4
MAX_UPLOAD_MB=25
MAX_DOCUMENTS=200
MAX_CHUNKS_PER_DOCUMENT=2000
